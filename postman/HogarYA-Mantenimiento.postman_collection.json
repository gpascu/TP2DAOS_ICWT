      "value": "",
      "type": "string"
    },
    {
      "key": "informesUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "historialUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaPrimerInforme",
