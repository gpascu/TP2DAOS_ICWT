  "item": [
    {
      "name": "Preparación 1. Crear contrato vigente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contratos",
        "description": "Prepara un contrato dedicado a la prueba y obtiene su ID desde Location.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propietario\": \"Propietario Prueba S03\",\n  \"inquilino\": \"Inquilino Prueba S03\",\n  \"direccionPropiedad\": \"Calle Prueba S03 123\",\n  \"fechaInicio\": \"{{fechaInicioPrueba}}\",\n  \"duracionMeses\": 12,\n  \"importeMensual\": 350000,\n  \"diaVencimiento\": 10,\n  \"descripcion\": \"Dato de prueba de la Actividad 02\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const hoy = new Date();",
              "const fechaLocal = [",
              "    hoy.getFullYear(),",
              "    String(hoy.getMonth() + 1).padStart(2, \"0\"),",
              "    String(hoy.getDate()).padStart(2, \"0\")",
              "].join(\"-\");",
              "pm.collectionVariables.set(\"fechaInicioPrueba\", fechaLocal);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "const id = location.split(\"/\").pop();",
              "marca(\"Location contiene el ID del contrato\", /^[1-9][0-9]*$/.test(id));",
              "pm.collectionVariables.set(\"contratoId\", id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Preparación 2. Crear contrato activo vencido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contratos",
        "description": "Prepara un contrato dedicado a la prueba y obtiene su ID desde Location.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propietario\": \"Propietario Prueba S03\",\n  \"inquilino\": \"Inquilino Prueba S03\",\n  \"direccionPropiedad\": \"Calle Prueba S03 123\",\n  \"fechaInicio\": \"2000-01-01\",\n  \"duracionMeses\": 1,\n  \"importeMensual\": 350000,\n  \"diaVencimiento\": 10,\n  \"descripcion\": \"Dato de prueba de la Actividad 02\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "const id = location.split(\"/\").pop();",
              "marca(\"Location contiene el ID del contrato\", /^[1-9][0-9]*$/.test(id));",
              "pm.collectionVariables.set(\"contratoVencidoId\", id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01. Alta de incidente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes",
        "description": "El sistema genera el ID, la fecha y el estado ABIERTO. Guarda el ID para los casos siguientes.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contratoId\": {{contratoId}},\n  \"titulo\": \"Pérdida en la cocina\",\n  \"descripcion\": \"Sale agua debajo de la pileta.\",\n  \"categoria\": \"PLOMERIA\",\n  \"prioridad\": \"MEDIA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const incidente = pm.response.json();",
              "marca(\"Incidente abierto y con fecha\", incidente.estado === \"ABIERTO\" && !!incidente.fechaHoraAlta);",
              "marca(\"Location apunta al incidente\", pm.response.headers.get(\"Location\") === incidente._links.self.href);",
              "pm.collectionVariables.set(\"incidenteId\", incidente.id);",
              "pm.collectionVariables.set(\"fechaHoraAlta\", incidente.fechaHoraAlta);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Consulta por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}",
        "description": "Devuelve el incidente creado y sus enlaces."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const incidente = pm.response.json();",
              "const id = pm.collectionVariables.get(\"incidenteId\");",
              "marca(\"Es el incidente creado\", String(incidente.id) === String(id));",
              "marca(\"Tiene los enlaces de detalle\", [\"self\", \"contrato\", \"informes\", \"historial\"]",
              "    .every(rel => !!incidente._links[rel].href));",
              "marca(\"El enlace a informes filtra por este incidente\",",
              "    incidente._links.informes.href.endsWith(\"/informes-resolucion?incidenteId=\" + id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Listado filtrado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes?contratoId={{contratoId}}&estado=ABIERTO&categoria=PLOMERIA&prioridad=MEDIA",
        "description": "Combina los cuatro filtros. Incluye el incidente recién creado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const respuesta = pm.response.json();",
              "const filas = respuesta._embedded.incidentes;",
              "const contratoId = pm.collectionVariables.get(\"contratoId\");",
              "const id = pm.collectionVariables.get(\"incidenteId\");",
              "marca(\"Incluye el incidente creado\", filas.some(i => String(i.id) === String(id)));",
              "marca(\"Todos cumplen los filtros\", filas.every(i => String(i.contratoId) === String(contratoId)",
              "    && i.estado === \"ABIERTO\" && i.categoria === \"PLOMERIA\" && i.prioridad === \"MEDIA\"));",
              "marca(\"Self conserva los filtros\", respuesta._links.self.href.includes(\"estado=ABIERTO\"));",
              "}"
            ]
          }
        }
      ]
    },
