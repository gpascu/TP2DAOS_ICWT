  "item": [
    {
      "name": "Preparación. Crear contrato vigente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contratos",
        "description": "Prepara un contrato dedicado a la prueba y obtiene su ID desde Location.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propietario\": \"Propietario Prueba S03\",\n  \"inquilino\": \"Inquilino Prueba S03\",\n  \"direccionPropiedad\": \"Calle Prueba S03 123\",\n  \"fechaInicio\": \"{{fechaInicioPrueba}}\",\n  \"duracionMeses\": 12,\n  \"importeMensual\": 350000,\n  \"diaVencimiento\": 10,\n  \"descripcion\": \"Dato de prueba de la Actividad 02\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const hoy = new Date();",
              "const fechaLocal = [",
              "    hoy.getFullYear(),",
              "    String(hoy.getMonth() + 1).padStart(2, \"0\"),",
              "    String(hoy.getDate()).padStart(2, \"0\")",
              "].join(\"-\");",
              "pm.collectionVariables.set(\"fechaInicioPrueba\", fechaLocal);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "const id = location.split(\"/\").pop();",
              "marca(\"Location contiene el ID del contrato\", /^[1-9][0-9]*$/.test(id));",
              "pm.collectionVariables.set(\"contratoId\", id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01. Registrar el incidente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes",
        "description": "Arranca ABIERTO.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contratoId\": {{contratoId}},\n  \"titulo\": \"Pérdida en la cocina\",\n  \"descripcion\": \"Sale agua debajo de la pileta.\",\n  \"categoria\": \"PLOMERIA\",\n  \"prioridad\": \"MEDIA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const incidente = pm.response.json();",
              "marca(\"Incidente abierto y con fecha\", incidente.estado === \"ABIERTO\" && !!incidente.fechaHoraAlta);",
              "marca(\"Location apunta al incidente\", pm.response.headers.get(\"Location\") === incidente._links.self.href);",
              "pm.collectionVariables.set(\"incidenteId\", incidente.id);",
              "pm.collectionVariables.set(\"fechaHoraAlta\", incidente.fechaHoraAlta);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Rechazar una resolución antes de atender",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion",
        "description": "S04 solo admite resolver desde EN_PROCESO.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": {{incidenteId}},\n  \"descripcionTrabajo\": \"Se reemplazó el sello de la pileta.\",\n  \"costo\": 15000,\n  \"responsable\": \"Técnico de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 409\", pm.response.code === 409);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Iniciar la atención",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}/estado",
        "description": "El incidente queda EN_PROCESO.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"EN_PROCESO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "marca(\"Estado actualizado\", pm.response.json().estado === \"EN_PROCESO\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Rechazar un costo negativo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion",
        "description": "El costo debe ser mayor o igual a cero.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": {{incidenteId}},\n  \"descripcionTrabajo\": \"Se reemplazó el sello de la pileta.\",\n  \"costo\": -1,\n  \"responsable\": \"Técnico de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 400\", pm.response.code === 400);"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Resolver por primera vez",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion",
        "description": "Guarda el informe y resuelve el mismo incidente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": {{incidenteId}},\n  \"descripcionTrabajo\": \"Se reemplazó el sello de la pileta.\",\n  \"costo\": 15000,\n  \"responsable\": \"Técnico de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "marca(\"Location identifica un informe\", location.includes(\"/informes-resolucion/\")",
              "    && /^[1-9][0-9]*$/.test(location.split(\"/\").pop()));",
              "pm.collectionVariables.set(\"primerInformeId\", location.split(\"/\").pop());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Consultar el primer informe",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion/{{primerInformeId}}",
        "description": "El informe enlaza al incidente que acaba de resolver."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const informe = pm.response.json();",
              "const id = pm.collectionVariables.get(\"incidenteId\");",
              "marca(\"Mismo incidente\", String(informe.incidenteId) === String(id));",
              "marca(\"Enlace al incidente\", informe._links.incidente.href.endsWith(\"/incidentes/\" + id));",
              "marca(\"Tiene enlace self\", !!informe._links.self.href);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Rechazar un informe duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion",
        "description": "El incidente sigue RESUELTO y no admite un segundo informe para esta transición.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": {{incidenteId}},\n  \"descripcionTrabajo\": \"Se reemplazó el sello de la pileta.\",\n  \"costo\": 15000,\n  \"responsable\": \"Técnico de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 409\", pm.response.code === 409);"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Verificar el historial tras los rechazos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}/historial",
        "description": "Solo hay alta, inicio y primera resolución."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const estados = pm.response.json()._embedded.historial.map(e => e.estadoNuevo);",
              "marca(\"Solo tres entradas válidas\", estados.join() === \"ABIERTO,EN_PROCESO,RESUELTO\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Verificar los informes tras los rechazos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion?incidenteId={{incidenteId}}",
        "description": "S04 devuelve solo el informe válido para este incidente."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const respuesta = pm.response.json();",
              "const filas = Array.isArray(respuesta) ? respuesta",
              "    : (respuesta._embedded?.informes ?? respuesta._embedded?.informeResolucionResponseDTOList ?? []);",
              "marca(\"Solo está el primer informe\", filas.length === 1",
              "    && String(filas[0].id) === String(pm.collectionVariables.get(\"primerInformeId\")));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Reabrir el incidente",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}/estado",
        "description": "El incidente queda REABIERTO.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"REABIERTO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "marca(\"Estado actualizado\", pm.response.json().estado === \"REABIERTO\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Iniciar la segunda atención",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}/estado",
        "description": "El incidente queda EN_PROCESO.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"EN_PROCESO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "marca(\"Estado actualizado\", pm.response.json().estado === \"EN_PROCESO\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Resolver por segunda vez",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/informes-resolucion",
        "description": "Guarda el informe y resuelve el mismo incidente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": {{incidenteId}},\n  \"descripcionTrabajo\": \"Se ajustaron las conexiones.\",\n  \"costo\": 0,\n  \"responsable\": \"Técnico de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "marca(\"Location identifica un informe\", location.includes(\"/informes-resolucion/\")",
              "    && /^[1-9][0-9]*$/.test(location.split(\"/\").pop()));",
              "pm.collectionVariables.set(\"segundoInformeId\", location.split(\"/\").pop());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Obtener los enlaces del incidente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}",
        "description": "El incidente queda RESUELTO y sus enlaces permiten consultar ambos recursos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const incidente = pm.response.json();",
              "marca(\"El incidente queda resuelto\", incidente.estado === \"RESUELTO\");",
              "pm.collectionVariables.set(\"informesUrl\", incidente._links.informes.href);",
              "pm.collectionVariables.set(\"historialUrl\", incidente._links.historial.href);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Seguir el enlace a los informes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{informesUrl}}",
        "description": "Se conservan dos informes distintos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const respuesta = pm.response.json();",
              "const filas = Array.isArray(respuesta) ? respuesta",
              "    : (respuesta._embedded?.informes ?? respuesta._embedded?.informeResolucionResponseDTOList ?? []);",
              "const primero = filas.find(i => String(i.id) === String(pm.collectionVariables.get(\"primerInformeId\")));",
              "const segundo = filas.find(i => String(i.id) === String(pm.collectionVariables.get(\"segundoInformeId\")));",
              "const id = String(pm.collectionVariables.get(\"incidenteId\"));",
              "marca(\"Son dos informes del mismo incidente\", filas.length === 2 && !!primero && !!segundo",
              "    && primero.id !== segundo.id && filas.every(i => String(i.incidenteId) === id));",
              "if (primero && segundo) {",
              "    pm.collectionVariables.set(\"fechaPrimerInforme\", primero.fechaHoraResolucion);",
              "    pm.collectionVariables.set(\"fechaSegundoInforme\", segundo.fechaHoraResolucion);",
              "}",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Seguir el enlace al historial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{historialUrl}}",
        "description": "Se conservan seis cambios y ambas fechas coinciden con sus informes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const entradas = pm.response.json()._embedded.historial;",
              "const estados = entradas.map(e => e.estadoNuevo);",
              "marca(\"Recorrido completo\", estados.join() === \"ABIERTO,EN_PROCESO,RESUELTO,REABIERTO,EN_PROCESO,RESUELTO\");",
              "marca(\"Primera fecha compartida\", !!entradas[2]?.fechaHora && entradas[2].fechaHora === pm.collectionVariables.get(\"fechaPrimerInforme\"));",
              "marca(\"Segunda fecha compartida\", !!entradas[5]?.fechaHora && entradas[5].fechaHora === pm.collectionVariables.get(\"fechaSegundoInforme\"));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
