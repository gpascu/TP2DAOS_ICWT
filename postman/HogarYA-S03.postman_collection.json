          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes?contratoId={{contratoVencidoId}}",
        "description": "El conflicto de vigencia no dejó incidentes relacionados."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const respuesta = pm.response.json();",
              "const filas = respuesta._embedded && respuesta._embedded.incidentes || [];",
              "marca(\"El listado está vacío\", filas.length === 0 && !!respuesta._links.self.href);",
              "}"
            ]
          }
        }
      ]
