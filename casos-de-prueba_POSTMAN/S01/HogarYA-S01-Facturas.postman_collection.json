{
  "info": {
    "_postman_id": "2a1f4c9e-7b3d-4e21-9c5a-0d8f6b7a1e01",
    "name": "HogarYA · S01 Facturas · 6 casos + adicionales",
    "description": "Coleccion autocontenida para S01 (API corregida: 201/200 con cuerpo y links HATEOAS). Crea sus propios contratos, usa fechas dinamicas y cubre los seis tipos de caso pedidos: alta exitosa, consulta por ID, listado con filtro, datos invalidos, recurso inexistente y conflicto de negocio. Incluye ademas anulacion/reemision y vencimiento en el ultimo dia del mes. Ejecutar en orden sobre una base de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preparacion",
      "item": [
        {
          "name": "00 - Crear contrato de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contratos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contratos"
              ]
            },
            "description": "Crea un contrato activo de 12 meses con vencimiento el dia 28. El periodo de facturacion se calcula para el mes siguiente, de modo que el vencimiento sea futuro.",
            "body": {
              "mode": "raw",
              "raw": "{\"propietario\":\"Propietario S01\",\"inquilino\":\"Inquilino S01\",\"direccionPropiedad\":\"Calle S01 123\",\"fechaInicio\":\"{{fechaInicioPrueba}}\",\"duracionMeses\":12,\"importeMensual\":350000,\"diaVencimiento\":28,\"descripcion\":\"Contrato creado por la coleccion S01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date();",
                  "const pad = n => String(n).padStart(2, '0');",
                  "const fecha = `${hoy.getFullYear()}-${pad(hoy.getMonth() + 1)}-${pad(hoy.getDate())}`;",
                  "const proximo = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 1);",
                  "const periodo = `${proximo.getFullYear()}-${pad(proximo.getMonth() + 1)}`;",
                  "pm.collectionVariables.set('fechaInicioPrueba', fecha);",
                  "pm.collectionVariables.set('periodoPrueba', periodo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const partes = loc.split('/');",
                  "const id = partes[partes.length - 1];",
                  "pm.test('Location de contrato con ID', () => { pm.expect(loc).to.include('/contratos/'); pm.expect(Number.isInteger(Number(id))).to.eql(true); });",
                  "pm.collectionVariables.set('contratoId', id);",
                  "pm.test('Cuerpo con self link', () => pm.expect(pm.response.json()._links?.self).to.exist);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Casos obligatorios S01",
      "item": [
        {
          "name": "01 - Alta exitosa de factura mensual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/facturas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "facturas"
              ]
            },
            "description": "Sin importe, el servicio emite la facturacion mensual con el importe del contrato. Esperado: 201, Location y cuerpo con self, datos autocompletados y sin link pago.",
            "body": {
              "mode": "raw",
              "raw": "{\"idContrato\":{{contratoId}},\"periodo\":\"{{periodoPrueba}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const loc = pm.response.headers.get('Location') || '';",
                  "const partes = loc.split('/');",
                  "const id = partes[partes.length - 1];",
                  "pm.test('Location de factura con ID', () => { pm.expect(loc).to.include('/facturas/'); pm.expect(Number.isInteger(Number(id))).to.eql(true); });",
                  "pm.collectionVariables.set('facturaId', id);",
                  "const b = pm.response.json();",
                  "pm.test('Datos de la factura mensual autocompletados', () => { pm.expect(b.tipo).to.eql('MENSUAL'); pm.expect(b.estado).to.eql('PENDIENTE'); pm.expect(Number(b.importe)).to.eql(350000); });",
                  "pm.test('Emision de hoy y vencimiento dentro del periodo', () => { const hoy = new Date().toISOString().slice(0,10); pm.expect(b.fechaEmision).to.eql(hoy); pm.expect(b.fechaVencimiento.startsWith(b.periodo)).to.eql(true); });",
                  "pm.test('Links self y contrato', () => { pm.expect(b._links?.self).to.exist; pm.expect(b._links?.contrato).to.exist; });",
                  "pm.test('Sin link de pago', () => pm.expect(b._links?.pago).to.not.exist);"
                ]
              }
            }
          ]
        },
