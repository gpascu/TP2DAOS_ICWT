    {
      "name": "Preparación. Crear contrato vigente",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const hoy = new Date();",
              "const fechaLocal = [",
              "    hoy.getFullYear(),",
              "    String(hoy.getMonth() + 1).padStart(2, \"0\"),",
              "    String(hoy.getDate()).padStart(2, \"0\")",
              "].join(\"-\");",
              "pm.collectionVariables.set(\"fechaInicioPrueba\", fechaLocal);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "const id = location.split(\"/\").pop();",
              "marca(\"Location contiene el ID del contrato\", /^[1-9][0-9]*$/.test(id));",
              "pm.collectionVariables.set(\"contratoId\", id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propietario\": \"Propietario Prueba S03\",\n  \"inquilino\": \"Inquilino Prueba S03\",\n  \"direccionPropiedad\": \"Calle Prueba S03 123\",\n  \"fechaInicio\": \"{{fechaInicioPrueba}}\",\n  \"duracionMeses\": 12,\n  \"importeMensual\": 350000,\n  \"diaVencimiento\": 10,\n  \"descripcion\": \"Dato de prueba de la Actividad 02\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/contratos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "contratos"
          ]
        },
        "description": "Prepara un contrato dedicado a la prueba y obtiene su ID desde Location."
      },
      "response": []
    },
