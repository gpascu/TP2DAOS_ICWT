      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const entradas = pm.response.json()._embedded.historial;",
              "marca(\"Una sola entrada de alta\", entradas.length === 1 && entradas[0].estadoAnterior == null",
              "    && entradas[0].estadoNuevo === \"ABIERTO\");",
              "marca(\"Coincide con la fecha de alta\", entradas[0].fechaHora === pm.collectionVariables.get(\"fechaHoraAlta\"));",
              "}"
            ]
          }
        }
      ]
