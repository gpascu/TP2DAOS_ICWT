        ],
        "url": "{{baseUrl}}/incidentes?contratoId={{contratoId}}",
        "description": "El contrato de prueba conserva únicamente el incidente válido."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const filas = pm.response.json()._embedded.incidentes;",
              "marca(\"Hay una sola alta\", filas.length === 1 && filas[0].estado === \"CANCELADO\");",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Verificar que el contrato vencido no tiene altas",
      "request": {
        "method": "GET",
