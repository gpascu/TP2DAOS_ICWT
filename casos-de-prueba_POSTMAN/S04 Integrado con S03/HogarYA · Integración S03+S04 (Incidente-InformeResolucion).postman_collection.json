      "name": "01. Registrar el incidente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 201\", pm.response.code === 201);",
              "if (pm.response.code === 201) {",
              "const incidente = pm.response.json();",
              "marca(\"Incidente abierto y con fecha\", incidente.estado === \"ABIERTO\" && !!incidente.fechaHoraAlta);",
              "marca(\"Location apunta al incidente\", pm.response.headers.get(\"Location\") === incidente._links.self.href);",
              "pm.collectionVariables.set(\"incidenteId\", incidente.id);",
              "pm.collectionVariables.set(\"fechaHoraAlta\", incidente.fechaHoraAlta);",
              "}"
            ]
          }
        }
