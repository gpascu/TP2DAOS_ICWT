  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Crea datos nuevos en cada ejecucion completa del Runner.",
          "if (pm.info.requestName.startsWith('01 ')) {",
          "  ['s04ContratoId','s04IncidenteId','s04InformeId','s04FechaResolucion'].forEach(",
          "    k => pm.collectionVariables.unset(k)",
          "  );",
          "  pm.collectionVariables.set('s04FechaInicio',",
          "    new Date(Date.now() - 30 * 86400000).toISOString().slice(0,10));",
          "  pm.collectionVariables.set('s04Sufijo', String(Date.now()));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Una sola rutina de pruebas para las 10 solicitudes.",
          "const paso = Number(pm.info.requestName.slice(0, 2));",
          "const esperados = {1:201, 2:201, 3:200, 4:400, 5:404,",
          "                  6:201, 7:200, 8:409, 9:200, 10:200};",
          "pm.test('HTTP esperado: ' + esperados[paso], () =>",
          "  pm.response.to.have.status(esperados[paso]));",
          "",
          "// Recupera los IDs, tanto de Location (201 sin body) como del JSON.",
          "const destinos = {1:'s04ContratoId', 2:'s04IncidenteId', 6:'s04InformeId'};",
          "if (destinos[paso] && pm.response.code === 201) {",
          "  const location = pm.response.headers.get('Location') || '';",
          "  let id = (location.match(/\\/(\\d+)\\/?(?:\\?.*)?$/) || [])[1];",
          "  if (!id && pm.response.text().trim()) {",
          "    try { id = String(pm.response.json().id || ''); } catch (_) {}",
          "  }",
          "  pm.test('ID generado', () => pm.expect(id).to.match(/^[1-9]\\d*$/));",
          "  if (id) pm.collectionVariables.set(destinos[paso], id);",
          "}",
          "",
          "// Compatible con el listado original (array) y el mejorado (HAL _embedded).",
          "function lista(body) {",
          "  if (Array.isArray(body)) return body;",
          "  return Object.values(body._embedded || {}).flat().filter(x => x && typeof x === 'object');",
          "}",
          "if (paso === 7 && pm.response.code === 200) {",
          "  const inf = pm.response.json();",
          "  pm.test('GET del informe correcto', () =>",
          "    pm.expect(String(inf.id)).to.eql(pm.collectionVariables.get('s04InformeId')));",
          "  pm.test('Enlace HATEOAS self', () =>",
          "    pm.expect(inf._links.self.href).to.include('/informes-resolucion/'));",
          "  pm.collectionVariables.set('s04FechaResolucion', inf.fechaHoraResolucion);",
          "}",
          "if (paso === 9 && pm.response.code === 200) {",
          "  const informes = lista(pm.response.json());",
          "  pm.test('Filtrado: solo el informe del incidente', () => {",
          "    pm.expect(informes.length).to.eql(1);",
          "    pm.expect(String(informes[0].id)).to.eql(pm.collectionVariables.get('s04InformeId'));",
          "    pm.expect(String(informes[0].incidenteId)).to.eql(pm.collectionVariables.get('s04IncidenteId'));",
          "  });",
          "}",
          "if (paso === 10 && pm.response.code === 200) {",
          "  const historial = lista(pm.response.json());",
          "  pm.test('Historial: ABIERTO, EN_PROCESO, RESUELTO', () => {",
          "    pm.expect(historial.map(h => h.estadoNuevo)).to.eql(",
          "      ['ABIERTO','EN_PROCESO','RESUELTO']);",
          "    pm.expect(historial[2].estadoAnterior).to.eql('EN_PROCESO');",
          "  });",
          "  pm.test('Informe e historial con la misma fecha/hora', () =>",
          "    pm.expect(historial[2].fechaHora).to.eql(pm.collectionVariables.get('s04FechaResolucion')));",
          "}"
        ]
      }
    }
