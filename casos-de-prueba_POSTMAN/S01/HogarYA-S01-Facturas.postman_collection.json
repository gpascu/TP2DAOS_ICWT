              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('ID consultado coincide', () => pm.expect(String(b.id)).to.eql(pm.collectionVariables.get('facturaId')));",
                  "pm.test('Datos persistidos', () => { pm.expect(b.tipo).to.eql('MENSUAL'); pm.expect(b.estado).to.eql('PENDIENTE'); pm.expect(Number(b.importe)).to.eql(350000); pm.expect(b.periodo).to.eql(pm.collectionVariables.get('periodoPrueba')); });",
                  "pm.test('Links self y contrato', () => { pm.expect(b._links?.self).to.exist; pm.expect(b._links?.contrato).to.exist; });",
                  "pm.test('Sin pago asociado', () => pm.expect(b._links?.pago).to.not.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Listado con filtros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/facturas?contratoId={{contratoId}}&periodo={{periodoPrueba}}&estado=PENDIENTE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "facturas"
              ],
              "query": [
                {
                  "key": "contratoId",
                  "value": "{{contratoId}}"
                },
                {
                  "key": "periodo",
                  "value": "{{periodoPrueba}}"
                },
                {
                  "key": "estado",
                  "value": "PENDIENTE"
                }
              ]
            },
            "description": "Lista por contrato, periodo y estado. Esperado: 200 con _embedded.facturas y _links.self del listado conservando los filtros."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const filas = b._embedded?.facturas ?? [];",
                  "pm.test('Listado HAL con self', () => pm.expect(b._links?.self).to.exist);",
                  "pm.test('Self conserva los filtros', () => pm.expect(b._links.self.href).to.include('estado=PENDIENTE'));",
                  "pm.test('Contiene la factura creada', () => pm.expect(filas.some(f => String(f.id) === pm.collectionVariables.get('facturaId'))).to.eql(true));",
                  "pm.test('Cada factura tiene self', () => pm.expect(filas.every(f => f._links?.self)).to.eql(true));"
                ]
              }
            }
          ]
        },
