    {
      "name": "14. Seguir el enlace a los informes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const respuesta = pm.response.json();",
              "const filas = Array.isArray(respuesta) ? respuesta : (respuesta._embedded?.informes ?? []);",
              "const primero = filas.find(i => String(i.id) === String(pm.collectionVariables.get(\"primerInformeId\")));",
              "const segundo = filas.find(i => String(i.id) === String(pm.collectionVariables.get(\"segundoInformeId\")));",
              "const id = String(pm.collectionVariables.get(\"incidenteId\"));",
              "marca(\"Son dos informes del mismo incidente\", filas.length === 2 && !!primero && !!segundo",
              "    && primero.id !== segundo.id && filas.every(i => String(i.incidenteId) === id));",
              "pm.collectionVariables.set(\"fechaPrimerInforme\", primero.fechaHoraResolucion);",
              "pm.collectionVariables.set(\"fechaSegundoInforme\", segundo.fechaHoraResolucion);",
              "}"
            ]
          }
        }
