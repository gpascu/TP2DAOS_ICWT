{
  "info": {
    "name": "HogarYA · Recorrido integrado de mantenimiento · S03 y S04",
    "description": "Requiere los dos módulos en la misma API. Ejecutar en orden en una base de prueba. Crea un contrato y un incidente propios por ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "contratoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "incidenteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaInicioPrueba",
      "value": "",
