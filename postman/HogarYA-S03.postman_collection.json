    {
      "name": "10. Verificar que el rechazo no dejó cambios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/hal+json, application/json"
          }
        ],
        "url": "{{baseUrl}}/incidentes/{{incidenteId}}/historial",
        "description": "Conserva ABIERTO → EN_PROCESO como último cambio y no agrega RESUELTO."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function marca(nombre, condicion) { pm.test(nombre, () => pm.expect(condicion).to.eql(true)); }",
              "marca(\"HTTP 200\", pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "const entradas = pm.response.json()._embedded.historial;",
              "marca(\"Solo hay alta e inicio\", entradas.length === 2 && entradas[0].estadoNuevo === \"ABIERTO\"",
              "    && entradas[1].estadoAnterior === \"ABIERTO\" && entradas[1].estadoNuevo === \"EN_PROCESO\");",
              "marca(\"El historial está ordenado\", new Date(entradas[0].fechaHora) <= new Date(entradas[1].fechaHora));",
              "}"
            ]
          }
        }
      ]
    },
